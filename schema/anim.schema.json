{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/goju2k/ribs-assets/schema/anim.schema.json",
  "title": "ribs-assets animation export (contract 1)",
  "type": "object",
  "required": [
    "contract",
    "id",
    "texture",
    "frameSize",
    "clips"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "texture": {
      "type": "string",
      "pattern": "\\.png$"
    },
    "frameSize": {
      "$ref": "#/$defs/pair"
    },
    "anchor": {
      "$ref": "#/$defs/pair"
    },
    "clips": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/clip"
      }
    },
    "source": {
      "type": "string",
      "pattern": "^ribs-assets@[0-9a-f]{7,40}$"
    }
  },
  "$defs": {
    "pair": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "clip": {
      "type": "object",
      "required": [
        "loop",
        "frames"
      ],
      "additionalProperties": false,
      "properties": {
        "loop": {
          "type": "boolean"
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frame"
          }
        }
      }
    },
    "frame": {
      "type": "object",
      "required": [
        "sx",
        "sy",
        "sWidth",
        "sHeight",
        "durationMs"
      ],
      "additionalProperties": false,
      "properties": {
        "sx": {
          "type": "integer",
          "minimum": 0
        },
        "sy": {
          "type": "integer",
          "minimum": 0
        },
        "sWidth": {
          "type": "integer",
          "minimum": 1
        },
        "sHeight": {
          "type": "integer",
          "minimum": 1
        },
        "durationMs": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+:[a-z0-9-]+$"
          }
        }
      }
    }
  }
}
